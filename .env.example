# Скопируйте в .env и при необходимости измените (.env в git не попадает)

# Папка с данными: zones.json, calibrations/, video/, reports/
# PSAFETY_DATA_DIR=.

# DEBUG / INFO / WARNING / ERROR
PSAFETY_LOG_LEVEL=INFO

# 1 — логи в JSON (для Docker / ELK)
PSAFETY_LOG_JSON=0

# Путь к ffmpeg, если его нет в PATH (Windows: ffmpeg/bin/ffmpeg.exe ищется автоматически)
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe

# Ключ API Яндекс.Карт для карты камер
YANDEX_MAPS_API_KEY=
