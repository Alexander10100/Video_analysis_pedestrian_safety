<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_retraining" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.11.1">
  <bpmn:error id="Error_deploy" name="DeployFailed" errorCode="DEPLOY_FAILED" />
  <bpmn:collaboration id="Collab_retraining">
    <bpmn:participant id="Pool_mlops" name="Retraining-цикл модели классификации взрослый/ребёнок" processRef="Process_retraining" />
  </bpmn:collaboration>
  <bpmn:process id="Process_retraining" name="Retraining по дрифту" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_monitoring" name="Мониторинг (автоматически)">
        <bpmn:flowNodeRef>Start_daily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_drift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_drift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_nodrift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_drift</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pipeline" name="ML-пайплайн (автоматически)">
        <bpmn:flowNodeRef>Task_dataset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_trainA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_trainB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_auction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_better</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_nogain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_nogain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_human" name="ML-инженер (human-in-the-loop)">
        <bpmn:flowNodeRef>User_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_sla</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_deploy" name="Деплой (CI/CD)">
        <bpmn:flowNodeRef>Task_deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_registry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_deploy_err</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_daily" name="Ежедневно 03:00">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Start_daily_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT24H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_drift" name="Рассчитать метрики дрифта (PSI высоты bbox, доля unknown)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_drift" name="Триггер по дрифту: PSI &gt; 0.2?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_nodrift" name="Дрифта нет">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_drift" name="Telegram: обнаружен дрифт, старт retraining">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_dataset" name="Собрать датасет vN+1 (новая разметка + история)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_split">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_trainA" name="Retraining модели A (дообучение текущей)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_trainB" name="Retraining модели B (альтернативная архитектура)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_join">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_eval" name="Оценить A и B на hold-out: ROC-AUC, F1, fairness">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_auction" name="Аукцион по AUC: выбрать модель с max AUC">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_better" name="AUC победителя &gt; AUC прод-модели?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Send_nogain" name="Telegram: улучшения нет, прод-модель остаётся">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_nogain" name="Прод-модель без изменений">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="User_validate" name="Валидация: метрики, Model Card, проверка на видео">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Send_remind" name="Telegram: напоминание валидатору">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_remind" name="Напоминание отправлено">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_approved" name="Модель одобрена?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_reject" name="Зафиксировать причину отказа">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Send_reject" name="Telegram: модель отклонена (причина)">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_reject" name="Модель отклонена">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_deploy" name="Деплой лучшей модели: canary 10% → 100%">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_rollback" name="Откат на предыдущую версию модели">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_alert" name="Telegram: ALERT, деплой откачен">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_rollback" name="Откат выполнен">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_registry" name="Обновить реестр моделей и Model Card">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_done" name="Telegram: новая модель в проде (версия, AUC)">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_done" name="Модель обновлена">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_sla" name="48 ч без решения" attachedToRef="User_validate" cancelActivity="false">
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_sla_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_deploy_err" name="Ошибка деплоя / рост ошибок" attachedToRef="Task_deploy">
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Boundary_deploy_err_def" errorRef="Error_deploy" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_daily" targetRef="Task_drift" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_drift" targetRef="Gw_drift" />
    <bpmn:sequenceFlow id="F3" name="Нет" sourceRef="Gw_drift" targetRef="End_nodrift">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${psi &lt;= 0.2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="Да" sourceRef="Gw_drift" targetRef="Send_drift">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${psi &gt; 0.2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="Send_drift" targetRef="Task_dataset" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_dataset" targetRef="Gw_split" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_split" targetRef="Task_trainA" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_split" targetRef="Task_trainB" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_trainA" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_trainB" targetRef="Gw_join" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_join" targetRef="Task_eval" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_eval" targetRef="Task_auction" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_auction" targetRef="Gw_better" />
    <bpmn:sequenceFlow id="F14" name="Нет" sourceRef="Gw_better" targetRef="Send_nogain">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${winnerAuc &lt;= prodAuc}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="Send_nogain" targetRef="End_nogain" />
    <bpmn:sequenceFlow id="F16" name="Да" sourceRef="Gw_better" targetRef="User_validate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${winnerAuc &gt; prodAuc}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="User_validate" targetRef="Gw_approved" />
    <bpmn:sequenceFlow id="F18" name="Нет" sourceRef="Gw_approved" targetRef="Task_reject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="Task_reject" targetRef="Send_reject" />
    <bpmn:sequenceFlow id="F20" sourceRef="Send_reject" targetRef="End_reject" />
    <bpmn:sequenceFlow id="F21" name="Да" sourceRef="Gw_approved" targetRef="Task_deploy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_deploy" targetRef="Task_registry" />
    <bpmn:sequenceFlow id="F23" sourceRef="Task_registry" targetRef="Send_done" />
    <bpmn:sequenceFlow id="F24" sourceRef="Send_done" targetRef="End_done" />
    <bpmn:sequenceFlow id="F25" sourceRef="Boundary_sla" targetRef="Send_remind" />
    <bpmn:sequenceFlow id="F26" sourceRef="Send_remind" targetRef="End_remind" />
    <bpmn:sequenceFlow id="F27" sourceRef="Boundary_deploy_err" targetRef="Task_rollback" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_rollback" targetRef="Send_alert" />
    <bpmn:sequenceFlow id="F29" sourceRef="Send_alert" targetRef="End_rollback" />
    <bpmn:textAnnotation id="Note_auction">
      <bpmn:text>Аукцион: обе модели оцениваются на одном hold-out; побеждает наибольший ROC-AUC. В прод — только если победитель лучше текущей модели (champion/challenger).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Note_auction_assoc" sourceRef="Note_auction" targetRef="Task_auction" />
    <bpmn:textAnnotation id="Note_hitl">
      <bpmn:text>Human-in-the-loop: без одобрения инженера модель не попадает в прод. Проверяются метрики, fairness (дети/взрослые, день/ночь) и Model Card.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_drift">
      <bpmn:text>Дрифт: PSI распределения высоты bbox и доли unknown по сравнению с эталонной неделей. Порог 0.2 — стандарт для PSI.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_retraining">
      <bpmndi:BPMNShape id="Pool_mlops_di" bpmnElement="Pool_mlops" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2440" height="880" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_monitoring_di" bpmnElement="Lane_monitoring" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2410" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_pipeline_di" bpmnElement="Lane_pipeline" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="2410" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_human_di" bpmnElement="Lane_human" isHorizontal="true">
        <dc:Bounds x="190" y="560" width="2410" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_deploy_di" bpmnElement="Lane_deploy" isHorizontal="true">
        <dc:Bounds x="190" y="760" width="2410" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_daily_di" bpmnElement="Start_daily">
        <dc:Bounds x="232" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="224" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_drift_di" bpmnElement="Task_drift">
        <dc:Bounds x="330" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_drift_di" bpmnElement="Gw_drift" isMarkerVisible="true">
        <dc:Bounds x="535" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="247" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_nodrift_di" bpmnElement="End_nodrift">
        <dc:Bounds x="542" y="94" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="586" y="104" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_drift_di" bpmnElement="Send_drift">
        <dc:Bounds x="650" y="160" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_dataset_di" bpmnElement="Task_dataset">
        <dc:Bounds x="650" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_split_di" bpmnElement="Gw_split">
        <dc:Bounds x="845" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_trainA_di" bpmnElement="Task_trainA">
        <dc:Bounds x="940" y="325" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_trainB_di" bpmnElement="Task_trainB">
        <dc:Bounds x="940" y="455" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_join_di" bpmnElement="Gw_join">
        <dc:Bounds x="1125" y="405" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_eval_di" bpmnElement="Task_eval">
        <dc:Bounds x="1220" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_auction_di" bpmnElement="Task_auction">
        <dc:Bounds x="1380" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_better_di" bpmnElement="Gw_better" isMarkerVisible="true">
        <dc:Bounds x="1585" y="405" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1555" y="359" width="110" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_nogain_di" bpmnElement="Send_nogain">
        <dc:Bounds x="1700" y="390" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_nogain_di" bpmnElement="End_nogain">
        <dc:Bounds x="1892" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1865" y="454" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="User_validate_di" bpmnElement="User_validate">
        <dc:Bounds x="1540" y="620" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_remind_di" bpmnElement="Send_remind">
        <dc:Bounds x="1360" y="620" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_remind_di" bpmnElement="End_remind">
        <dc:Bounds x="1272" y="642" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1245" y="684" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_approved_di" bpmnElement="Gw_approved" isMarkerVisible="true">
        <dc:Bounds x="1745" y="635" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1675" y="587" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reject_di" bpmnElement="Task_reject">
        <dc:Bounds x="1850" y="620" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Send_reject_di" bpmnElement="Send_reject">
        <dc:Bounds x="2010" y="620" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_reject_di" bpmnElement="End_reject">
        <dc:Bounds x="2202" y="642" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2175" y="684" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
